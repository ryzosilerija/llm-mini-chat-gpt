{
  "model": {
    "vocab_size": 16384,
    "d_model": 512,
    "n_layer": 8,
    "n_head": 8,
    "max_seq_len": 512,
    "tie_embeddings": true
  },
  "train": {
    "stage": "pretrain",
    "out_dir": "checkpoints/pretrain",
    "train_data": "data/pretrain/train.bin",
    "val_data": "data/pretrain/val.bin",
    "tokenizer": "checkpoints/tokenizer.json",
    "batch_size": 32,
    "grad_accum": 4,
    "seq_len": 512,
    "max_steps": 10000,
    "optimizer": "muon",
    "lr_muon": 0.02,
    "lr_adamw": 0.003,
    "warmup_steps": 300,
    "schedule": "wsd",
    "decay_frac": 0.2,
    "eval_interval": 500,
    "eval_iters": 50,
    "save_interval": 500
  }
}
